# The Mesub MCP server. Read once at start: a value that does not fit stops
# the process with a line naming the variable. See the README.

# REQUIRED. What this server proves itself to the Mesub API with, beside the
# agent's token: 32 characters at least, visible ASCII, no space, no quote, no
# backslash. Write it bare, without quotes around it. The API holds the same
# value in MCP_SERVICE_SECRET. Generate one with `openssl rand -base64 48`.
# Without it the server does not start. Not an API key: it opens nothing
# without an agent's token.
# Rotating it is a hard cut: the API holds one value, so every request is
# answered 503 from the moment the two sides differ until they agree again.
# Change it on the API and on every instance here, and restart both together.
MESUB_SERVICE_SECRET=

# REQUIRED. The Mesub API's public URL, an origin without a path: the
# authorization server this server names, and the issuer of every token it
# takes. The API's own PUBLIC_API_URL, character for character.
MESUB_ISSUER_URL=http://localhost:3333

# The Mesub HTTP API the tools and the token checks call. Usually the same as
# the issuer; a private address when the API is reached from inside. https,
# unless it is this machine.
MESUB_API_URL=http://localhost:3333

# Only for plain http to ANOTHER machine: says the network between this server
# and the API is private. The service secret and every token cross it in clear.
# MESUB_API_PRIVATE_NETWORK=true

# 3000 is the dashboard's, locally.
PORT=3334
# HOST=127.0.0.1

# Where clients reach this server: an origin, without /mcp nor any path.
# Unset: http://localhost:<PORT>. <MCP_PUBLIC_URL>/mcp must be the API's
# MCP_RESOURCE_URL, character for character: the server writes it at start, on
# a line named "resource".
# MCP_PUBLIC_URL=https://mcp.example.com

# More origins a browser may call from, separated by commas, each with its
# scheme and its port if any.
# MCP_ALLOWED_ORIGINS=https://app.example.com

# The address a request counts as. REQUIRED once MCP_PUBLIC_URL is not on this
# machine; pick the line that matches what stands in front of the server.
#
# A header is believed only because ONE proxy writes it over whatever the
# client sent. If the server can be reached any other way than through that
# proxy, a client writes the header itself and counts as any address it likes.
# Close every other way in first.
#
#   behind the platform proxy alone, on a public address:
# CLIENT_IP_HEADER=fly-client-ip
#   behind a tunnel from an edge network, with NO public address:
# CLIENT_IP_HEADER=cf-connecting-ip
#   behind an edge network and then the platform proxy, on a public address:
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXY_CIDRS=<the ranges the edge network publishes, separated by commas>
#   behind something else, or when unsure: the socket peer. Behind a proxy
#   every caller then counts as one address. Nobody is refused for it.
# CLIENT_IP_HEADER=none

# debug, info, warn, error or silent.
# LOG_LEVEL=info
