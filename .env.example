# The Mesub MCP server. Read once at start: a value that does not fit stops
# the process with a line naming the variable. See the README.

# REQUIRED. What this server proves itself to the Mesub API with, beside the
# agent's token: 32 characters at least, visible ASCII, no space. The API holds
# the same value in MCP_SERVICE_SECRET. Generate one with
# `openssl rand -base64 48`. Without it the server does not start. Not an API
# key: it opens nothing without an agent's token.
MESUB_SERVICE_SECRET=

# REQUIRED. The Mesub API's public URL, an origin without a path: the
# authorization server this server names, and the issuer of every token it
# takes. The API's own PUBLIC_API_URL, character for character.
MESUB_ISSUER_URL=http://localhost:3333

# The Mesub HTTP API the tools and the token checks call. Usually the same as
# the issuer; a private address when the API is reached from inside.
MESUB_API_URL=http://localhost:3333

# 3000 is the dashboard's, locally.
PORT=3334
# HOST=127.0.0.1

# Where clients reach this server, without /mcp. Unset: http://localhost:<PORT>.
# <MCP_PUBLIC_URL>/mcp must be the API's MCP_RESOURCE_URL.
# MCP_PUBLIC_URL=https://mcp.example.com

# More hostnames a browser Origin may carry, separated by commas.
# MCP_ALLOWED_ORIGINS=

# Behind a proxy: the header it writes the client's address in, for the rate
# limits. cf-connecting-ip or fly-client-ip. Unset: the socket peer.
# CLIENT_IP_HEADER=

# debug, info, warn, error or silent.
# LOG_LEVEL=info
