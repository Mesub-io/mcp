{
  "name": "@mesub/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "The Mesub MCP server: lets an AI agent read and act on one Mesub project.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mesub-io/mcp.git"
  },
  "homepage": "https://github.com/Mesub-io/mcp#readme",
  "bugs": "https://github.com/Mesub-io/mcp/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/ test/ scripts/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:index": "node scripts/build-docs-index.mjs",
    "docs:check": "node scripts/build-docs-index.mjs --check",
    "docs:stale": "node scripts/build-docs-index.mjs --stale",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "oxlint --deny-warnings",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
